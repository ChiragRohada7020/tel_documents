# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
API_KEY=replace_with_a_long_random_api_key

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=document_vault

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.3

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Webhook / Polling
WEBHOOK_URL=
POLLING_MODE=true

# Google Cloud (for Vision API / OCR)
GOOGLE_APPLICATION_CREDENTIALS=

# OCR (OCR.space cloud engine; Tesseract optional local fallback)
OCR_LANGUAGES=en,hi,mr
OCR_SPACE_API_KEY=your_ocr_space_api_key_here
# With multiple OCR_LANGUAGES: 'auto' lets OCR.space detect the script, 'first' uses only the first
OCR_SPACE_LANGUAGE_MODE=auto
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image
OCR_SPACE_ENGINE=2
OCR_TIMEOUT_SECONDS=30

# Feature flags
ENABLE_OCR=false
ENABLE_LOCAL_EMBEDDINGS=false

# App environment
APP_ENV=development
LOG_LEVEL=INFO

# File upload limits
MAX_FILE_SIZE_MB=20
DOCUMENT_PAGE_SIZE=8
# Keep personal document searches and file delivery out of group chats by default.
ALLOW_GROUP_DOCUMENT_ACCESS=false

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Conversation
MAX_CONVERSATION_HISTORY=20

# Upload processing time limits
DOWNLOAD_TIMEOUT_SECONDS=120
EMBEDDING_TIMEOUT_SECONDS=180
METADATA_TIMEOUT_SECONDS=60

# Expiry reminders
REMINDER_TIMEZONE=Asia/Kolkata
REMINDER_HOUR=9
EXPIRY_REMINDER_DAYS=30,7,1,0
